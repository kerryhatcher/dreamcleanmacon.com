---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  photos: { src: ImageMetadata; alt: string; caption: string }[];
}
const { photos } = Astro.props;
---
<div class="work-comparisons">
  {photos.map(photo => (
    <figure>
      <Image src={photo.src} alt={photo.alt} widths={[400, 700, 1000]} sizes="(max-width: 700px) 90vw, 40vw" format="webp" loading="lazy" />
      <figcaption>{photo.caption}<span>Before &amp; after</span></figcaption>
    </figure>
  ))}
</div>
<style>
  .work-comparisons { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 36px 24px; max-width: 1000px; margin-top: 36px; align-items: start; }
  img { width: 100%; height: auto; }
  figcaption { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; padding: 16px 0; border-bottom: 1px solid var(--rule); font-family: var(--sans); font-size: 16px; line-height: 1.5; }
  figcaption span { color: var(--muted); font-size: 13px; }
  @media (max-width: 700px) { .work-comparisons { grid-template-columns: 1fr; gap: 28px; } }
</style>
