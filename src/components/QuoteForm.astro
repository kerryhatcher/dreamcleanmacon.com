---
import Arrow from './Arrow.astro';
---
<section id="quote" class="quote-section section-wrap" aria-labelledby="quote-title">
  <div class="quote-heading">
    <h2 id="quote-title">Let’s get<br />in touch.</h2>
    <p>Leave your contact details so we can talk about your cleaning needs.</p>
    <p id="form-preview" class="form-preview">Online requests are coming soon. This form is a preview; your information won’t be sent.</p>
    <a href="tel:+16782328614" class="text-link">Call for a quote <Arrow /></a>
    <a class="quote-phone" href="tel:+16782328614">(678) 232-8614</a>
  </div>
  <form aria-label="Cleaning quote contact form preview" aria-describedby="form-preview">
    <fieldset>
      <legend>Your contact details</legend>
      <div class="form-grid">
        <div class="field full"><label for="name">Your name</label><input id="name" name="name" type="text" autocomplete="name" /></div>
        <div class="field"><label for="phone">Phone number</label><input id="phone" name="phone" type="tel" autocomplete="tel" /></div>
        <div class="field"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" /></div>
      </div>
    </fieldset>
    <div class="form-close">
      <button class="button" type="submit" disabled aria-describedby="form-preview">Request a quote <Arrow diagonal /></button>
      <p>Prefer to talk? <a href="tel:+16782328614">Call (678) 232-8614.</a></p>
    </div>
  </form>
</section>
