---
import Arrow from './Arrow.astro';

// Both values are public routing configuration, never credentials. A malformed
// setting must fail the build instead of silently sending inquiries elsewhere.
const htpEndpoint = import.meta.env.PUBLIC_HTP_FORM_ENDPOINT;
if (htpEndpoint) {
  let url: URL;
  try { url = new URL(htpEndpoint); } catch { throw new Error('Invalid PUBLIC_HTP_FORM_ENDPOINT'); }
  if (url.protocol !== 'https:' || !/^[a-z0-9-]+\.supabase\.co$/.test(url.hostname) || url.port || url.username || url.password || url.pathname !== '/functions/v1/form-submit' || url.hash || [...url.searchParams.keys()].join() !== 'form' || !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(url.searchParams.get('form') || '')) {
    throw new Error('Invalid PUBLIC_HTP_FORM_ENDPOINT');
  }
}
const endpoint = htpEndpoint || 'https://formspree.io/f/xeaoybzw';
---
<section id="quote" class="quote-section section-wrap" aria-labelledby="quote-title">
  <div class="quote-heading">
    <h2 id="quote-title">Let’s get<br />in touch.</h2>
    <p>Leave your contact details so we can talk about your cleaning needs.</p>
    <p id="form-note" class="form-note">Name and email are required so we can follow up with you. You’ll see a confirmation when your request is received.</p>
    <a href="tel:+16782328614" class="text-link">Call for a quote <Arrow /></a>
    <a class="quote-phone" href="tel:+16782328614">(678) 232-8614</a>
  </div>
  <form data-quote-form action={endpoint} data-htp={htpEndpoint ? "true" : "false"} method="POST" aria-label="Cleaning quote contact form" aria-describedby="form-note">
    <p class="form-status" data-form-status role="status" aria-live="polite" aria-atomic="true" tabindex="-1"></p>
    {htpEndpoint && <div hidden><label for="website">Leave this field empty</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>}
    <fieldset>
      <legend>Your contact details</legend>
      <div class="form-grid">
        <div class="field full"><label for="name">Your name (required)</label><input id="name" name="name" type="text" autocomplete="name" required /></div>
        <div class="field"><label for="phone">Phone number (optional)</label><input id="phone" name="phone" type="tel" autocomplete="tel" /></div>
        <div class="field"><label for="email">Email address (required)</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
        <div class="field full"><label for="message">Tell us about your cleaning needs (optional)</label><textarea id="message" name="message" rows="4" placeholder="Your location, type of cleaning, and preferred timing"></textarea></div>
      </div>
    </fieldset>
    <div class="form-close">
      <button class="button" type="submit"><span data-submit-label>Request a quote</span> <Arrow diagonal /></button>
      <p>Prefer to talk? <a href="tel:+16782328614">Call (678) 232-8614.</a></p>
    </div>
  </form>
</section>

<script>
  import { trackInquiry } from '../scripts/inquiry-tracking';

  document.querySelectorAll<HTMLFormElement>('[data-quote-form]').forEach(form => {
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const label = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const htp = form.dataset.htp === 'true';
    const storageKey = `dreamclean-quote:${form.action}`;
    type Payload = { submission_id: string; name: string; email: string; phone: string; message: string; website: string };
    let saved: Payload | null = null;
    try {
      const value = sessionStorage.getItem(storageKey);
      if (htp && value) {
        const parsed = JSON.parse(value);
        if (['submission_id', 'name', 'email', 'phone', 'message', 'website'].every(key => typeof parsed?.[key] === 'string')) saved = parsed;
      }
    } catch { /* Storage is optional; keep retry state in memory. */ }
    if (saved) {
      for (const key of ['name', 'email', 'phone', 'message'] as const) {
        (form.elements.namedItem(key) as HTMLInputElement).value = saved[key];
      }
      status.dataset.state = 'error';
      status.textContent = 'Your previous request could not be confirmed. Retry with these same details, or call (678) 232-8614 before changing them.';
    }
    const persist = (payload: Payload | null) => {
      saved = payload;
      try { if (payload) sessionStorage.setItem(storageKey, JSON.stringify(payload)); else sessionStorage.removeItem(storageKey); } catch { /* In-memory retry still works. */ }
    };
    let pending = false;
    let submitted = false;

    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (pending || submitted || !form.reportValidity()) return;
      const hadSaved = saved !== null;
      const values = new FormData(form);
      let body: FormData | string = values;
      if (htp) {
        const fields = { name: String(values.get('name') || ''), email: String(values.get('email') || ''), phone: String(values.get('phone') || ''), message: String(values.get('message') || ''), website: String(values.get('website') || '') };
        if (saved && (Object.keys(fields) as (keyof typeof fields)[]).some(key => saved![key] !== fields[key])) {
          status.dataset.state = 'error';
          status.textContent = 'Your earlier request may have been received. Please restore the original details to retry, or call (678) 232-8614 before sending changes.';
          status.focus();
          return;
        }
        const payload = saved || { submission_id: crypto.randomUUID(), ...fields };
        persist(payload);
        body = JSON.stringify(payload);
      }
      pending = true;
      button.disabled = true;
      label.textContent = 'Sending…';
      form.setAttribute('aria-busy', 'true');
      status.textContent = '';
      delete status.dataset.state;
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 20000);

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body,
          headers: htp ? { Accept: 'application/json', 'Content-Type': 'application/json' } : { Accept: 'application/json' },
          signal: controller.signal,
        });
        const result = await response.json();
        if (!response.ok || result?.ok !== true) {
          status.dataset.state = 'error';
          if (htp && response.status === 409) {
            status.textContent = 'We couldn’t reconcile this request with an earlier submission. Please call (678) 232-8614 before trying again.';
          } else {
            const definite = [413, 422, 429].includes(response.status);
            if (htp && definite && !hadSaved) persist(null);
            status.textContent = !htp || (definite && !hadSaved)
              ? 'Your request wasn’t accepted. Please check your details and try again, or call (678) 232-8614.'
              : 'We couldn’t confirm your request. Your details are still here. Please call (678) 232-8614 to check before trying again.';
          }
          return;
        }

        submitted = true;
        if (htp) persist(null);
        form.reset();
        form.querySelector('fieldset')!.disabled = true;
        label.textContent = 'Request sent';
        status.dataset.state = 'success';
        status.textContent = 'Thank you. Your quote request has been received. We’ll follow up using your contact details. Your visit is not booked yet.';
        trackInquiry('generate_lead', { form_id: 'cleaning_quote', contact_method: 'quote_form' });
      } catch {
        // A lost response can follow an accepted POST. Never silently resubmit.
        status.dataset.state = 'error';
        status.textContent = 'We couldn’t confirm your request. Your details are still here. Please call (678) 232-8614 to check before trying again.';
      } finally {
        window.clearTimeout(timeout);
        pending = false;
        form.removeAttribute('aria-busy');
        if (!submitted) {
          button.disabled = false;
          label.textContent = 'Request a quote';
        }
        status.focus();
      }
    });
  });
</script>

<style>
  .form-status:not(:empty) { padding: 18px; margin-bottom: 24px; border: 1px solid currentColor; }
  .form-status[data-state="error"] { font-weight: 600; }
  button:disabled { cursor: default; opacity: .7; }
</style>
