---
import { Image } from 'astro:assets';
import '@fontsource/playfair-display/latin-400.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-600.css';
import '../styles/home.css';
import ovenBefore from '../../public/images/oven-before.jpg';
import ovenAfter from '../../public/images/oven-after.jpg';
import stoveBefore from '../../public/images/stovetop-before.jpg';
import stoveAfter from '../../public/images/stovetop-after.jpg';
import refrigerator from '../../public/images/refrigerator-before-after.jpg';
import team from '../../public/images/team.jpg';
import Arrow from '../components/Arrow.astro';
import QuoteForm from '../components/QuoteForm.astro';
import '../styles/global.css';
import { facebook, googleBusiness, counties, areaServed } from '../data/business';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(base, Astro.site);
const title = 'Apartment & Airbnb Cleaning in Macon, GA | Dream Clean';
const description = 'Apartment and Airbnb move-in / move-out cleaning in Macon and Middle Georgia. Experienced with property managers. Housekeeping for homes, too. Request a quote.';
const organizationId = `${canonical.href}#organization`;
// Only facts supported by the visible page and supplied business sources.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Dream Clean Housekeeping Company, LLC',
      url: canonical.href,
      logo: new URL(`${base}images/logo.png`, canonical).href,
      telephone: '+1-678-232-8614',
      description,
      sameAs: [facebook, googleBusiness],
      areaServed,
    },
    {
      '@type': 'Service',
      '@id': `${canonical.href}#housekeeping-service`,
      name: 'Housekeeping',
      serviceType: 'House cleaning',
      url: new URL(`${base}housekeeping/`, canonical).href,
      provider: { '@id': organizationId },
      areaServed,
    },
    {
      '@type': 'Service',
      '@id': `${canonical.href}#property-cleaning-service`,
      name: 'Move-in / move-out cleaning',
      serviceType: 'Move-in / move-out cleaning for homes, apartments, and Airbnb properties',
      url: new URL(`${base}move-in-move-out-cleaning/`, canonical).href,
      provider: { '@id': organizationId },
      areaServed,
    },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf8f3" />
    <title>{title}</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dream Clean" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(`${base}images/logo.png`, canonical)} />
    <meta property="og:image:alt" content="Dream Clean Housekeeping Co. logo" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  </head>
  <body class="commercial-home">
    <a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
                <a class="brand" href="#main" aria-label="Dream Clean home"><img src={`${base}images/logo.png`} alt="Dream Clean Housekeeping Co." width="500" height="500" /></a>
                <nav aria-label="Main navigation">
                  <a href="#property-cleaning">Property cleaning</a>
                  <a href={`${base}housekeeping/`}>Housekeeping</a>
                  <a href="#about">About</a>
                </nav>
                <a class="header-phone" href="tel:+16782328614">(678) 232-8614</a>
              </header>
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-heading">
          <h1 id="hero-title">A fresh start<br />for every property.</h1>
        </div>
        <div class="hero-intro">
          <p>Apartment and Airbnb move-in / move-out cleaning in Macon &amp; Middle Georgia.</p>
          <p>Experienced with property managers and their needs and schedules.</p>
          <a class="button" href="#quote">Request a property quote <Arrow /></a>
        </div>
      </section>
      <div class="opening-proof">
        <figure class="property-proof">
          <div class="opening-comparison">
            <div><p class="photo-label">Before</p><div class="comparison-photo"><Image src={ovenBefore} alt="Before Dream Clean’s work: baked-on residue inside an oven and on its glass door" widths={[400, 700, 1000]} sizes="(max-width: 700px) 48vw, 36vw" format="webp" loading="eager" fetchpriority="high" /></div></div>
            <div><p class="photo-label">After</p><div class="comparison-photo"><Image src={ovenAfter} alt="After Dream Clean’s work: the same oven interior and glass door cleared of baked-on residue" widths={[400, 700, 1000]} sizes="(max-width: 700px) 48vw, 36vw" format="webp" loading="eager" /></div></div>
          </div>
          <figcaption>A closer look at our work. Real photos from Dream Clean.</figcaption>
        </figure>
        <aside class="home-invitation" aria-labelledby="home-invitation-title">
          <h2 id="home-invitation-title">For your<br /> home, too.</h2>
          <p>Housekeeping for homes in Macon &amp; Middle Georgia. Renewed tranquility for your everyday spaces.</p>
          <a class="text-link" href={`${base}housekeeping/`}>Explore housekeeping <Arrow /></a>
          <a class="home-call" href="tel:+16782328614">Call about your home</a>
        </aside>
      </div>
      <div class="experience-line"><p>Property cleaning,<br />with experience.</p><span>No job too big or too small.</span></div>
      <section class="manager-review section-wrap" aria-label="A property manager’s experience">
        <figure>
          <blockquote>“Since Julia has been working at my property she has blown me away with the exceptional level of cleans she has provided.”</blockquote>
          <figcaption>Andrew Cannon<span>Maintenance Manager · Supplied customer review</span></figcaption>
        </figure>
        <div><p>We understand property managers’ needs and schedules. Tell us about your property, your cleaning priorities, and the handover date you’re working toward.</p><a class="text-link" href="#property-cleaning">Cleaning for your property <Arrow /></a></div>
      </section>

      <section class="services section-wrap" aria-labelledby="services-title">
        <div class="section-intro">
          <h2 id="services-title">For the next occupant.<br />For your everyday.</h2>
          <p>Preparing an apartment or Airbnb property for someone new, or looking for help with your own home? Let’s talk about the cleaning you need.</p>
        </div>
        <div class="service-columns">
          <article id="property-cleaning">
            <h3>Apartment &amp; Airbnb<br />property cleaning.</h3>
            <p>Moving in, moving out, or preparing for the next occupants? Ask about cleaning for apartment complexes, Airbnb properties, and other move-in / move-out needs.</p>
            <p>Tell us the property’s size and condition, whether it will be empty or furnished, and your move or handover date. Mention appliance interiors or a property manager’s checklist so we can discuss the scope.</p>
            <a class="text-link" href={`${base}move-in-move-out-cleaning/`}>Explore move-in / move-out cleaning <Arrow /></a>
            <p class="service-detail">Move-in / move-out · Property clients</p>
            <a class="text-link" href="tel:+16782328614">Call about your property <Arrow /></a>
          </article>
          <article id="housekeeping">
            <h3>Housekeeping<br />for your home.</h3>
            <p>Housekeeping that makes room for a calmer day. Tell us about your home, the rooms you’d like cleaned, and the details that matter to you.</p>
            <p>Share your cleaning priorities, preferred timing, and any special care instructions. Discuss the tasks, supplies, and access arrangements for your visit when requesting a quote.</p>
            <a class="text-link" href={`${base}housekeeping/`}>Explore housekeeping in Macon <Arrow /></a>
            <p class="service-detail">Housekeeping · Homeowners</p>
            <a class="text-link" href="tel:+16782328614">Call about your home <Arrow /></a>
          </article>
        </div>
      </section>
      <section id="our-work" class="work section-wrap" aria-labelledby="work-title">
        <div class="section-intro">
          <h2 id="work-title">The difference is<br />in the details.</h2>
          <div><p>A closer look at Dream Clean’s work. These before-and-after photos come directly from our Facebook page.</p><a class="text-link" href={facebook}>More from Dream Clean <Arrow /></a></div>
        </div>
        <div class="more-work">
          <div class="stovetop-work">
            <h3>A clearer kitchen.</h3>
            <div class="work-pair compact">
              <figure><Image src={stoveBefore} alt="Before cleaning: cooking residue around a white electric stovetop’s burners" widths={[300, 500]} sizes="(max-width: 700px) 44vw, 24vw" format="webp" loading="lazy" /><figcaption>Before</figcaption></figure>
              <figure><Image src={stoveAfter} alt="After cleaning: the same white electric stovetop with clean burners and surface" widths={[300, 500]} sizes="(max-width: 700px) 44vw, 24vw" format="webp" loading="lazy" /><figcaption>After</figcaption></figure>
            </div>
          </div>
          <figure class="fridge-work"><Image src={refrigerator} alt="Dream Clean’s before-and-after comparison showing refrigerator shelves and drawers cleaned of residue" widths={[400, 700]} sizes="(max-width: 700px) 90vw, 32vw" format="webp" loading="lazy" /><figcaption>A fresh start for the refrigerator.</figcaption></figure>
        </div>
      </section>
      <section class="reviews" aria-labelledby="reviews-title">
        <div class="section-wrap">
          <div class="section-intro"><h2 id="reviews-title">A calmer home.<br />A little peace of mind.</h2><a class="text-link" href={facebook}>Read our Facebook reviews <Arrow /></a></div>
          <div class="review-columns">
            <figure><blockquote>“They are also so kind, so accommodating and so genuinely enjoyable to talk to.”</blockquote><figcaption>Hannah Simmons<span>Facebook recommendation · March 2025</span></figcaption></figure>
            <figure><blockquote>“Dream Clean is the Dream Team! They were truly a lifesaver for me and my family.”</blockquote><figcaption>Beth Ann McKenzie<span>Facebook recommendation · September 2024</span></figcaption></figure>
          </div>
        </div>
      </section>
      <section id="about" class="about section-wrap" aria-labelledby="about-title">
        <figure class="team-photo"><Image src={team} alt="Three members of the Dream Clean team standing together in blue and black uniforms" widths={[400, 700, 1000]} sizes="(max-width: 700px) 90vw, 34vw" format="webp" loading="lazy" /><figcaption>The people behind the clean.</figcaption></figure>
        <div class="about-copy">
          <h2 id="about-title">Your neighbors.<br />Your Dream Clean.</h2>
          <p>Dream Clean Housekeeping Company, LLC is based in Macon, Georgia. We offer housekeeping and move-in / move-out cleaning, bringing renewed tranquility to homes and properties across Middle Georgia.</p>
          <a class="text-link" href={facebook}>Get to know Dream Clean <Arrow /></a>
          <div class="service-area"><h3>Here in Middle Georgia.</h3><p>Serving Macon and these surrounding counties:</p><ul>{counties.map(county => <li>{county} County</li>)}</ul><p class="area-note">Have a property nearby? <a href="tel:+16782328614">Call to discuss your location.</a></p></div>
        </div>
      </section>
      <QuoteForm />
    </main>
    <footer class="site-footer section-wrap">
      <div><p class="footer-name">Dream Clean.</p><p>Housekeeping Company, LLC<br />Macon &amp; Middle Georgia</p></div>
      <div class="footer-contact"><a href="tel:+16782328614">(678) 232-8614</a><a href={facebook}>Find us on Facebook <Arrow /></a><a href={googleBusiness}>Find us on Google <Arrow /></a></div>
      <p class="footer-close">A fresh start for your property. A calmer day at home.</p>
    </footer>
  </body>
</html>
