---
import '@fontsource/playfair-display/latin-400.css';
import '../styles/global.css';
import QuoteForm from '../components/QuoteForm.astro';
import { facebook, googleBusiness, areaServed } from '../data/business';
interface Props { title: string; description: string; heading: string; service: string; intro: string; relatedHref: string; relatedLabel: string; }
const { title, description, heading, service, intro, relatedHref, relatedLabel } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const home = new URL(base, Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);
const organizationId = `${home.href}#organization`;
const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Organization', '@id': organizationId, name: 'Dream Clean Housekeeping Company, LLC', url: home.href, telephone: '+1-678-232-8614', logo: new URL(`${base}images/logo.png`, home).href, sameAs: [facebook, googleBusiness], areaServed },
  { '@type': 'Service', '@id': `${canonical.href}#service`, name: service, serviceType: service, url: canonical.href, provider: { '@id': organizationId }, areaServed },
] };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f5ef" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dream Clean" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(`${base}images/logo.png`, home)} />
    <meta property="og:image:alt" content="Dream Clean Housekeeping Co. logo" />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={base} aria-label="Dream Clean home"><img src={`${base}images/logo.png`} alt="Dream Clean Housekeeping Co." width="500" height="500" /></a>
      <nav aria-label="Main navigation">
        <a href={`${base}housekeeping/`}>Housekeeping</a>
        <a href={`${base}move-in-move-out-cleaning/`}>Property cleaning</a>
        <a href={`${base}#about`}>About</a>
      </nav>
      <a class="header-phone" href="tel:+16782328614">(678) 232-8614</a>
    </header>
    <main id="main">
      <section class="service-hero section-wrap">
        <a class="text-link" href={base}>Dream Clean home</a>
        <p class="location">Macon, GA &amp; Middle Georgia</p>
        <h1>{heading}</h1>
        <p class="service-lead">{intro}</p>
        <a class="button service-cta" href="#quote">Request a quote</a>
      </section>
      <div class="service-body section-wrap"><slot /></div>
      <section class="section-wrap service-coverage" aria-labelledby="area-title">
        <h2 id="area-title">Here in Middle Georgia.</h2>
        <p>Dream Clean is based in Macon and serves Bibb, Houston, Crawford, Peach, Baldwin, Jones, Putnam, Monroe, and Wilkinson counties. Call with your property’s location to discuss your cleaning needs.</p>
        <a class="text-link" href={`${base}${relatedHref}`}>{relatedLabel}</a>
      </section>
      <QuoteForm />
    </main>
    <footer class="site-footer section-wrap">
      <div><p class="footer-name">Dream Clean.</p><p>Housekeeping Company, LLC<br />Macon &amp; Middle Georgia</p></div>
      <div class="footer-contact"><a href="tel:+16782328614">(678) 232-8614</a><a href={facebook}>Find us on Facebook</a><a href={googleBusiness}>Find us on Google</a></div>
      <p class="footer-close">A clean home. A calmer day.</p>
    </footer>
  </body>
</html>
<style>
  .service-hero { padding-top: 40px; padding-bottom: 60px; }
  .service-hero .location { margin-top: 24px; }
  h1 { font-size: clamp(42px, 6vw, 88px); line-height: 1.08; max-width: 16ch; }
  .service-lead { margin-top: 28px; }
  .service-cta { margin-top: 28px; width: fit-content; font-size: 21px; padding: 18px 24px; }
  .service-body { border-top: 1px solid var(--rule); padding-top: 60px; padding-bottom: 60px; }
  .service-body :global(section + section) { margin-top: 54px; }
  .service-body :global(h2) { margin-bottom: 24px; }
  .service-body :global(p + p) { margin-top: 18px; }
  .service-body :global(ul), .service-body :global(ol) { font-family: var(--sans); line-height: 1.8; max-width: 65ch; padding-left: 24px; }
  .service-body :global(li + li) { margin-top: 12px; }
  .service-body :global(.work-pair) { margin-top: 28px; max-width: 1000px; }
  .service-coverage { border-top: 1px solid var(--rule); }
  .service-coverage p { margin-top: 24px; }
</style>
