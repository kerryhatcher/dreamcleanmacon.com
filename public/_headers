# Baseline CSP: protect embedding, base URLs, plugins, and form destinations.
# Script restrictions require coordination with Cloudflare-injected Zaraz code.
/*
  Content-Security-Policy: base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://formspree.io
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
